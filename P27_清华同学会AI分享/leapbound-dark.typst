// ============================================================
// LeapBound AI Dark Solar Template — Pandoc Typst Template
// Based on LeapBound Solar Brand Design System
// Usage: pandoc input.md -o out.pdf --pdf-engine=typst --template=leapbound-dark.typst
// ============================================================

// ── Brand Colors (Solar Design System) ──────────────────────
#let void-indigo    = rgb("#0A0F24")       // 40% — primary background
#let leap-electric  = rgb("#5B5CFF")       // 20% — brand energy
#let signal-cyan    = rgb("#5FD6FF")       // 18% — glowing accents
#let volt-lime      = rgb("#D7FF3F")       // 12% — highlight / CTA
#let mist-lavender  = rgb("#C8C3FF")       //  7% — soft atmosphere
#let soft-fog       = rgb("#EEF2FF")       //  3% — light text

#let card-bg        = rgb("#111631")       // dark card background
#let card-border    = rgb("#1E2347")       // subtle card borders
#let text-primary   = rgb("#EEF2FF")       // main text
#let text-secondary = rgb("#9B9EC7")       // secondary text
#let table-row-alt  = rgb("#0E1329")       // alternating table row

// ── Pandoc metadata variables ────────────────────────────────
#let doc-title    = [$if(title)$$title$$else$品牌基建报告$endif$]
#let doc-subtitle = [$if(subtitle)$$subtitle$$endif$]
#let doc-date     = [$if(date)$$date$$endif$]
#let doc-project  = [$if(project_id)$$project_id$$endif$]
#let doc-type     = [$if(report_type)$$report_type$$else$AI Brand OS$endif$]

// ── Page Setup ───────────────────────────────────────────────
#set page(
  paper: "a4",
  flipped: true,
  margin: (top: 18mm, bottom: 18mm, left: 22mm, right: 20mm),
  fill: void-indigo,
  header: context {
    if counter(page).get().first() > 1 {
      stack(
        spacing: 4pt,
        grid(
          columns: (1fr, auto),
          align: (left + horizon, right + horizon),
          text(fill: mist-lavender, weight: "bold", size: 8pt)[#doc-title],
          text(fill: signal-cyan, weight: "bold", size: 8pt)[凌邦德智能 · LeapBound AI],
        ),
        line(length: 100%, stroke: 0.5pt + card-border),
      )
    }
  },
  footer: context {
    if counter(page).get().first() > 1 {
      stack(
        spacing: 4pt,
        line(length: 100%, stroke: 0.5pt + card-border),
        grid(
          columns: (1fr, auto, 1fr),
          align: (left + horizon, center + horizon, right + horizon),
          text(fill: text-secondary, size: 7.5pt)[LeapBound AI],
          text(fill: mist-lavender, size: 8pt)[#counter(page).display("1")],
          text(fill: text-secondary, size: 7.5pt)[#doc-date],
        ),
      )
    }
  },
)

// ── Typography ───────────────────────────────────────────────
#set text(
  font: ($if(mainfont)$"$mainfont$",$else$"Heiti SC",$endif$ "Arial"),
  size: 16pt,
  fill: text-primary,
  lang: "$if(lang)$$lang$$else$zh$endif$",
)

#set par(leading: 0.85em, spacing: 1.2em, justify: false)

// ── Heading Styles ───────────────────────────────────────────

// H1: Leap Electric gradient bar
#show heading.where(level: 1): it => block(
  width: 100%, above: 1.8em, below: 0.9em,
)[
  #block(
    width: 100%,
    fill: gradient.linear(leap-electric, signal-cyan, angle: 0deg),
    radius: 4pt, inset: (x: 16pt, y: 12pt),
  )[
    #set text(fill: void-indigo, size: 22pt, weight: "bold")
    #it.body
  ]
]

// H2: Signal Cyan left bar
#show heading.where(level: 2): it => block(
  above: 1.4em, below: 0.6em,
)[
  #grid(
    columns: (4pt, 1fr), gutter: 8pt,
    block(width: 4pt, height: 1.4em, fill: signal-cyan, radius: 2pt),
    block[
      #set text(fill: signal-cyan, size: 18pt, weight: "bold")
      #it.body
    ],
  )
]

// H3: Mist Lavender bold
#show heading.where(level: 3): it => block(
  above: 1.1em, below: 0.4em,
)[
  #set text(fill: mist-lavender, size: 16pt, weight: "bold")
  #it.body
]

// H4: Volt Lime bold
#show heading.where(level: 4): it => block(
  above: 0.9em, below: 0.3em,
)[
  #set text(fill: volt-lime, size: 15pt, weight: "bold")
  #it.body
]

// ── Table Styles ─────────────────────────────────────────────
#set table(
  inset: (x: 10pt, y: 8pt),
  stroke: 0.5pt + card-border,
  fill: (_, row) => if row == 0 { leap-electric.darken(30%) }
    else if calc.odd(row) { void-indigo }
    else { table-row-alt },
)

#show table.cell.where(y: 0): set text(
  fill: soft-fog, weight: "bold", size: 14pt,
)

#show table: it => block(
  width: 100%, above: 0.8em, below: 0.8em,
  radius: 3pt, clip: true,
  stroke: 0.5pt + card-border,
  it,
)

// ── Code Blocks ──────────────────────────────────────────────
#show raw.where(block: true): it => block(
  width: 100%, fill: card-bg,
  stroke: (left: 3pt + leap-electric),
  inset: (x: 12pt, y: 8pt),
  radius: (right: 3pt),
  above: 0.6em, below: 0.6em,
)[
  #set text(
    size: 8.5pt,
    font: ("JetBrains Mono", "Menlo", "Courier New"),
    fill: signal-cyan,
  )
  #it
]

#show raw.where(block: false): it => box(
  fill: card-bg,
  inset: (x: 4pt, y: 2pt), radius: 2pt,
)[
  #set text(size: 9pt, font: ("JetBrains Mono", "Menlo", "Courier New"), fill: signal-cyan)
  #it
]

// ── Block Quotes → Callout Boxes ─────────────────────────────
#show quote: it => block(
  width: 100%, fill: card-bg,
  stroke: (left: 4pt + volt-lime),
  inset: (x: 14pt, y: 10pt),
  radius: (right: 3pt),
  above: 0.8em, below: 0.8em,
)[
  #set text(fill: soft-fog, size: 15pt)
  #it.body
]

// ── Links ────────────────────────────────────────────────────
#show link: set text(fill: signal-cyan)

// ── Strong / Bold text ───────────────────────────────────────
#show strong: set text(fill: volt-lime)

// ── Horizontal Rule ──────────────────────────────────────────
#let horizontalrule = block(above: 1em, below: 1em)[
  #line(length: 100%, stroke: 1pt + leap-electric)
]

// ── List styling ─────────────────────────────────────────────
#set list(marker: text(fill: signal-cyan)[●])

// ── Cover Page ──────────────────────────────────────────────
#page(
  margin: (top: 0pt, bottom: 0pt, left: 0pt, right: 0pt),
  header: none,
  footer: none,
)[
  #block(width: 100%, height: 100%, fill: void-indigo)[

    // Top gradient accent line
    #place(top + left,
      block(width: 100%, height: 4pt,
        fill: gradient.linear(leap-electric, signal-cyan, volt-lime, angle: 0deg)
      )
    )

    // Decorative integral sign (brand logo element)
    #place(
      right + top,
      dx: -40mm,
      dy: 35mm,
    )[
      #text(
        size: 180pt,
        fill: leap-electric.lighten(80%).transparentize(88%),
        font: ("Times New Roman", "Georgia"),
        style: "italic",
      )[∫]
    ]

    // Main content — left-aligned
    #place(
      left + horizon,
      dx: 28mm,
      dy: -10mm,
      block(width: 148mm)[

        // Company name
        #block(below: 52mm)[
          #set text(fill: signal-cyan, size: 11pt, weight: "bold")
          凌邦德智能 · LeapBound AI
        ]

        // Report type badge
        #block(below: 7mm)[
          #box(
            fill: leap-electric,
            inset: (x: 10pt, y: 5pt),
            radius: 3pt,
          )[
            #set text(fill: soft-fog, size: 9pt, weight: "bold")
            #doc-type
          ]
        ]

        // Main title
        #block(below: 7mm)[
          #set text(fill: soft-fog, size: 24pt, weight: "bold")
          #doc-title
        ]

        // Subtitle
        #block(below: 14mm)[
          #set text(fill: signal-cyan, size: 13pt)
          $if(subtitle)$$subtitle$$elseif(client)$$client$$endif$
        ]

        // Gradient divider
        #block(below: 12mm)[
          #line(length: 56mm, stroke: 2pt + gradient.linear(leap-electric, signal-cyan))
        ]

        // Meta row
        #block[
          #set text(fill: text-secondary, size: 9pt)
          #grid(
            columns: (auto, 20pt, auto),
            $if(date)$[#doc-date],$else$[],$endif$
            [],
            $if(project_id)$[#doc-project],$else$[],$endif$
          )
        ]
      ]
    )

    // Bottom bar
    #place(
      bottom + left,
      block(
        width: 100%, fill: card-bg,
        inset: (x: 28mm, y: 10mm),
      )[
        #set text(fill: text-secondary, size: 8pt)
        #grid(
          columns: (1fr, auto),
          align: (left + horizon, right + horizon),
          [Prepared by 凌邦德智能 LeapBound AI],
          text(fill: volt-lime)[Context Engineering],
        )
      ]
    )

    // Bottom gradient line
    #place(bottom + left,
      block(width: 100%, height: 2pt,
        fill: gradient.linear(signal-cyan, leap-electric, volt-lime, angle: 0deg)
      )
    )
  ]
]

// ── Syntax Highlighting ──────────────────────────────────────
$if(highlighting-definitions)$
$highlighting-definitions$
$endif$

// ── Document Body ────────────────────────────────────────────
$body$
